# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./data/ballpark.db
GOOGLE_MAPS_API_KEY=
GOOGLE_URL_SIGNING_SECRET=
GOOGLE_DAILY_QUOTA=300
DAILY_RESERVED=100
DAILY_SALT=change-me
LAUNCH_DATE=2027-01-01
PUBLIC_BASE_URL=https://ballpark.example.com
CONTACT_EMAIL=you@example.com
SCRAPER_USER_AGENT=BallparkBot/1.0 (+https://ballpark.example.com/about; contact: you@example.com)
ADMIN_TOKEN=change-me            # protects nothing public; reserved for future admin endpoints
CORS_ORIGINS=http://localhost:5173
MAX_PRICE_AGE_YEARS=5
# Minimum eligible properties before a region/country option is selectable. With the demo seed
# (3-4 per country) every option except World stays "Coming soon"; set to 5 in dev to try regions.
MIN_POOL_PER_OPTION=50
# Public Nominatim is limited to 1 request/second and needs a real contact in SCRAPER_USER_AGENT.
# Point this at a self-hosted Nominatim to geocode faster.
NOMINATIM_URL=https://nominatim.openstreetmap.org
GHSL_SMOD_PATH=./data/ghsl/GHS_SMOD.tif
FX_MANUAL_CSV=./data/fx_manual.csv

# Ingestion (Phase 2)
FX_API_URL=https://api.frankfurter.app
POSTCODES_IO_URL=https://api.postcodes.io
INGEST_CACHE_DIR=./data/cache
# GHSL_SMOD_URL=   (override the GHS-SMOD download URL if the JRC moves the file)

# Rate limits per IP per hour (0 disables)
RATE_LIMIT_GAMES_PER_HOUR=30
RATE_LIMIT_GUESSES_PER_HOUR=120

# Deployment (docker compose / Caddy): the public hostname Caddy gets a certificate for.
DOMAIN=localhost
